custom: Target Rifle
	weapon: targetrifle
	spriteid: 334
	gun_muzzle_height: 3
	cock_sound: 2
	ammo_type: LOOT_RIFLE_SHELL
	boom_factor: 3.4
	spread_factor: 0
	reload: 1.15
	power: 0.40
	knockback: 1
	func: WEAPON_FUNC_SHOOT
	melee_windup_angle: 0
	melee_end_angle: 225
	melee_reach: -16
	ammo_max: 50
	melee_break_scale: 0
	melee_range: -5
	skill_angle_range: 22
	badmelee
	pointblank_far
	Crangedtier
	projectiles: 0 


: fire-targetbolt args( me )
		
			bullet
			
			\ sfx{ growl } 
			
			<- me thing# lt .throwerid!
			<- me .aim_angle@ lt .angle!

			map{ <- me .pos <- me .angle@ anglexy 17 xymul xyadd pos>tile tile@ 0 } <> <- me .mapid@ 0 <> and not if 
				<- me .pos lt .angle@ anglexy 7 xymul xyadd lt .pos!
			else
				<- me .pos lt .pos!
				\ no shooting out the map!
			then 

			' continue_pen lt .events! 
			 
			0.05 lt .hitcheck.shoot_thru!
			1.75 lt .hitcheck.knockback!
			3.25 lt .hitcheck.power! 		

			40 lt .anim.counter!

			lt .angle@ anglexy 8.5 xymul lt .vel! // Speed
			1 lt .timer!
			-3 <- me .breath - lt .pos.z!
			<- me .character@ .shooting@ STAT_SHOOTING <- me .character@ .bonus@ + 2 / >int 1 + 0 3 clamp lt .weapon_state.val! 


;
	
mission{
thing-event: targetrifle-events

	eventid THING_EVENT_ANIMATE = if
		me .anim.state@ if then;
		
		me .anim.counter@ 1 = if 
			0 me .weapon_state.frame!		
					\ sfx{ noise } 		
		then 
	then 

	eventid THING_EVENT_SHOOT = if
		me .ammocount 0 > if
			me fire-targetbolt
		then

		1 me .weapon_state.frame!
		1 me .weapon_state.val!
		me .cooldown@ 25 - me .anim.counter!
		0 me .weapon_state.val! 
	then
	
	eventid THING_EVENT_SHOOT <> if 
		1 me .weapon_state.off.x! 
	then 
;
}

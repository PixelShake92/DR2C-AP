: ap-item-711 morale--all -5 trunk-food+ "AP: Pandora..." ap-notify-item ;
: ap-item-730 10 trunk-food+ 10 trunk-gas+ 10 trunk-bullet+ 10 trunk-medical+ "AP: Supply Drop!" ap-notify-item ;

\ === SAFE DAMAGE HELPER ===
\ Skip damage entirely to prevent any deaths from traps
: ap-safe-ouch ( char -- )
    drop
;

\ Apply safe damage to all party members
: ap-safe-ouch-all
    \ Do nothing - traps won't deal HP damage
;


\ === RANDOM WEAPONS (500s) ===

\ Random weapon selection helpers - return weapon ID on stack
\ rnd takes (min max) and returns random number in that range
\ EXPANDED POOLS v3.6 - Many more weapons per tier!

: ap-random-common-melee
    \ 25 common melee weapons: bats, sticks, household items
    0 24 rnd
    dup 0 = if drop WEAPON_BASEBALL then      \ Baseball Bat
    dup 1 = if drop WEAPON_WOOD then          \ Piece of Wood
    dup 2 = if drop WEAPON_BROOM then         \ Broomstick
    dup 3 = if drop WEAPON_MOP then           \ Mop
    dup 4 = if drop WEAPON_FRYING then        \ Frying Pan
    dup 5 = if drop WEAPON_WRENCH then        \ Wrench
    dup 6 = if drop WEAPON_METAL then         \ Metal Pipe
    dup 7 = if drop WEAPON_GOLF then          \ Golf Club
    dup 8 = if drop WEAPON_HOCKEY then        \ Hockey Stick
    dup 9 = if drop WEAPON_CRICKET then       \ Cricket Bat
    dup 10 = if drop WEAPON_ALUMINUM then     \ Aluminum Bat
    dup 11 = if drop WEAPON_UMBRELLA then     \ Umbrella
    dup 12 = if drop WEAPON_FLASHLIGHT then   \ Flashlight
    dup 13 = if drop WEAPON_NAIL then         \ Nail Board
    dup 14 = if drop WEAPON_LOG then          \ Log
    dup 15 = if drop WEAPON_CLAWHAMMER then   \ Hammer (Claw Hammer)
    dup 16 = if drop WEAPON_RAKE then         \ Rake
    dup 17 = if drop WEAPON_SPOON then        \ Spoon
    dup 18 = if drop WEAPON_GUITAR then       \ Electric Guitar
    dup 19 = if drop WEAPON_KNITTING then     \ Knitting Needle
    dup 20 = if drop WEAPON_BEACH then        \ Beach Umbrella
    dup 21 = if drop WEAPON_BIGLOG then       \ Big Log
    dup 22 = if drop WEAPON_UPPERCUT then     \ Bonesaw / Boxing move
    dup 23 = if drop WEAPON_GAUNTLET then     \ Gauntlet
    drop WEAPON_DEVILFORK                     \ Devil Fork / Pitchfork
;


\ -----------------------------------------------------------------------------
\ TOILET MILESTONE CHECKS
\ -----------------------------------------------------------------------------

: ap-check-toilet-milestones
    \ Send check for current toilet count (server ignores if location doesn't exist)
    ap-toilets-opened ap-toilets-last-sent > if
        ap-toilets-opened 110 <= if
            7000 ap-toilets-opened + ap-send-check
            ($ "Toilet " ap-toilets-opened .. "!" .. $) ap-notify
            ap-toilets-opened to ap-toilets-last-sent
        then
    then
;

\ -----------------------------------------------------------------------------
\ RECRUIT MILESTONE CHECKS
\ -----------------------------------------------------------------------------

: ap-check-recruit-milestones
    \ Send check for current recruit count
    ap-recruits-done ap-recruits-last-sent > if
        ap-recruits-done 65 <= if
            8000 ap-recruits-done + ap-send-check
            ($ "Recruit " ap-recruits-done .. "!" .. $) ap-notify
            ap-recruits-done to ap-recruits-last-sent
        then
    then
;

\ -----------------------------------------------------------------------------
\ CONTAINER LOOT MILESTONE CHECKS
\ -----------------------------------------------------------------------------

: ap-check-container-milestones
    \ Send check for current container count
    ap-containers-looted ap-containers-last-sent > if
        ap-containers-looted 880 <= if
            9000 ap-containers-looted + ap-send-check
            ($ "Container " ap-containers-looted .. "!" .. $) ap-notify
            ap-containers-looted to ap-containers-last-sent
        then
    then
;

\ -----------------------------------------------------------------------------
\ SIEGE MILESTONE CHECKS (disabled - too unreliable)
\ -----------------------------------------------------------------------------

: ap-check-siege-milestones
    \ Send check for current siege count
    ap-sieges-done ap-siege-last-sent > if
        ap-sieges-done 65 <= if
            3000 ap-sieges-done + ap-send-check
            ($ "Siege " ap-sieges-done .. "!" .. $) ap-notify
            ap-sieges-done to ap-siege-last-sent
        then
    then
;

\ -----------------------------------------------------------------------------
\ WEAPON TRACKING
\ -----------------------------------------------------------------------------

0 value ap-wep-temp

: ap-count-all-weapons
    0 to ap-wep-temp
    weapondef{ WEAPON_COUNT } for
        i 1- trunk.weapon@ ap-wep-temp + to ap-wep-temp
    next
    ap-wep-temp
;

\ Debug: Print all AP stats (defined here so ap-count-all-weapons exists)
: ap-print-stats
    "=== AP Stats ===" print
    "Kills This Run: " print road{ kills-this-game } print
    "Kills Previous: " print ap-kills-total print
    "Kills Cumulative: " print ap-kills-total road{ kills-this-game } + print
    "Kills Last Sent: " print ap-kills-last print
    "Weapons This Run: " print ap-weapons-collected print
    "Weapons Previous: " print ap-weapons-total print
    "Weapons Cumulative: " print ap-weapons-total ap-weapons-collected + print
    "Weapons Last Sent: " print ap-weapon-count-last print
    "Locations Done: " print ap-missions-done print
    "Containers: " print ap-containers-looted print
    "Toilets: " print ap-toilets-opened print
    "Sieges: " print ap-sieges-done print
    "Recruits: " print ap-recruits-done print
    "================" print
;

: ap-check-weapon-categories
    "CHECKING WEAPONS..." print
    
    \ Handguns: Pistol, Snubnose, Uzi, Dolt (confirmed in weaponfilt.df)
    ap-found-handgun not if
        WEAPON_PISTOL roadtrip-has-weapon?
        WEAPON_SNUBNOSE roadtrip-has-weapon? or
        WEAPON_UZI roadtrip-has-weapon? or
        WEAPON_DOLT roadtrip-has-weapon? or
        dup "Has handgun:" print print
        if 
            4001 ap-send-check "Found Handgun!" ap-notify 
            1 to ap-found-handgun 
        then
    then
    
    \ Rifles: Hunting, Rifle, AK47 (confirmed)
    ap-found-rifle not if
        WEAPON_HUNTING roadtrip-has-weapon?
        WEAPON_RIFLE roadtrip-has-weapon? or
        WEAPON_AK47 roadtrip-has-weapon? or
        dup "Has rifle:" print print
        if 
            4002 ap-send-check "Found Rifle!" ap-notify 
            1 to ap-found-rifle 
        then
    then
    
    \ Shotguns (confirmed)
    ap-found-shotgun not if
        WEAPON_SHOTGUN roadtrip-has-weapon?
        WEAPON_AUTOSHOT roadtrip-has-weapon? or
        WEAPON_DAWG roadtrip-has-weapon? or
        dup "Has shotgun:" print print
        if 
            4003 ap-send-check "Found Shotgun!" ap-notify 
            1 to ap-found-shotgun 
        then
    then
    
    \ Blades: Knives from WEAPON_LIST_KNIVES + hatchet (confirmed)
    ap-found-blade not if
        WEAPON_KITCH roadtrip-has-weapon?
        WEAPON_CLEAVER roadtrip-has-weapon? or
        WEAPON_MACHETE1 roadtrip-has-weapon? or
        WEAPON_MACHETE2 roadtrip-has-weapon? or
        WEAPON_RAMBEUX roadtrip-has-weapon? or
        WEAPON_HATCHET roadtrip-has-weapon? or
        dup "Has blade:" print print
        if 
            4004 ap-send-check "Found Blade!" ap-notify 
            1 to ap-found-blade 
        then
    then
    
    \ Explosives: Grenades, Molotov (confirmed)
    ap-found-explosive not if
        WEAPON_GRENADE roadtrip-has-weapon?
        WEAPON_MOLOTOV roadtrip-has-weapon? or
        dup "Has explosive:" print print
        if 
            4005 ap-send-check "Found Explosive!" ap-notify 
            1 to ap-found-explosive 
        then
    then
    
    \ Heavy: Sledge, Fire Axe (confirmed as WEAPON_SLEDGE, WEAPON_FIRE)
    ap-found-heavy not if
        WEAPON_SLEDGE roadtrip-has-weapon?
        WEAPON_FIRE roadtrip-has-weapon? or
        dup "Has heavy:" print print
        if 
            4006 ap-send-check "Found Heavy Weapon!" ap-notify 
            1 to ap-found-heavy 
        then
    then
    
    \ Blunt Melee: Bats, clubs, hammers, etc
    ap-found-blunt not if
        WEAPON_BASEBALL roadtrip-has-weapon?
        WEAPON_ALUMINUM roadtrip-has-weapon? or
        WEAPON_CRICKET roadtrip-has-weapon? or
        WEAPON_GOLF roadtrip-has-weapon? or
        WEAPON_HOCKEY roadtrip-has-weapon? or
        WEAPON_CLAWHAMMER roadtrip-has-weapon? or
        dup "Has blunt:" print print
        if 
            4007 ap-send-check "Found Blunt Weapon!" ap-notify 
            1 to ap-found-blunt 
        then
    then
;

: ap-check-rare-weapons
    \ Only check weapons with confirmed constant names
    ap-found-flamethrower not if WEAPON_FLAMETHROWER roadtrip-has-weapon? if 
        4102 ap-send-check "Found Flamethrower!" ap-notify 1 to ap-found-flamethrower then then
    
    ap-found-minigun not if WEAPON_MINIGUN roadtrip-has-weapon? if 
        4103 ap-send-check "Found Minigun!" ap-notify 1 to ap-found-minigun then then
    
    ap-found-ak47 not if WEAPON_AK47 roadtrip-has-weapon? if 
        4105 ap-send-check "Found AK-47!" ap-notify 1 to ap-found-ak47 then then
    
    ap-found-sledge not if WEAPON_SLEDGE roadtrip-has-weapon? if 
        4106 ap-send-check "Found Sledgehammer!" ap-notify 1 to ap-found-sledge then then
    
    ap-found-fireaxe not if WEAPON_FIRE roadtrip-has-weapon? if 
        4107 ap-send-check "Found Fire Axe!" ap-notify 1 to ap-found-fireaxe then then
    
    ap-found-bow not if WEAPON_BOW roadtrip-has-weapon? if 
        4109 ap-send-check "Found Bow!" ap-notify 1 to ap-found-bow then then
;

: ap-check-weapon-count
    \ Cumulative weapons: total from previous runs + collected this run
    ap-weapons-total ap-weapons-collected + to ap-wep-temp
    \ Send ALL milestones from last sent up to current (1-220)
    begin
        ap-weapon-count-last 1 + ap-wep-temp <= while
        ap-weapon-count-last 1 + to ap-weapon-count-last
        ap-weapon-count-last 220 <= if
            4200 ap-weapon-count-last + ap-send-check
            ($ "Weapons " ap-weapon-count-last .. "!" .. $) ap-notify
        then
    repeat
;

: ap-check-weapons
    ap-game-active not if then;
    ap-check-weapon-categories
    ap-check-rare-weapons
    ap-check-weapon-count
;

\ -----------------------------------------------------------------------------
\ PERSISTENT PROGRESS FILE
\ Saves AP progress that persists across multiple runs/deaths
\ This file is GLOBAL - shared across all save slots for AP multiworld
\ -----------------------------------------------------------------------------

\ Use savename-prefix but NO slot number - progress is global across all slots
: AP_PROGRESS_FILE savename-prefix "ap_progress.sav" .. ;

\ Save cumulative progress to external file
: ap-save-progress
    "AP: Saving persistent progress" print
    save-start
        \ Global tracking
        ' ap-kills-total save-val
        ' ap-kills-accumulated save-val
        ' ap-weapons-total save-val
        ' ap-weapons-collected save-val
        ' ap-toilets-opened save-val
        ' ap-toilets-last-sent save-val
        ' ap-recruits-done save-val
        ' ap-recruits-last-sent save-val
        ' ap-containers-looted save-val
        ' ap-containers-last-sent save-val
        ' ap-sieges-done save-val
        ' ap-siege-last-sent save-val
        ' ap-missions-done save-val
        ' ap-missions-last-sent save-val
        ' ap-kills-last save-val
        ' ap-day-last save-val
        ' ap-day-clear-last save-val
        ' ap-victory-sent save-val
        ' ap-found-handgun save-val
        ' ap-found-rifle save-val
        ' ap-found-shotgun save-val
        ' ap-found-blade save-val
        ' ap-found-explosive save-val
        ' ap-found-heavy save-val
        ' ap-found-blunt save-val
        ' ap-found-flamethrower save-val
        ' ap-found-minigun save-val
        ' ap-found-ak47 save-val
        ' ap-found-sledge save-val
        ' ap-found-fireaxe save-val
        ' ap-found-bow save-val
        ' ap-weapon-count-last save-val
        ' ap-items-received save-val
        
        \ Per-mode tracking - Normal
        ' ap-normal-missions save-val
        ' ap-normal-days save-val
        ' ap-normal-days-clear save-val
        ' ap-normal-victory save-val
        
        \ Per-mode tracking - Familiar

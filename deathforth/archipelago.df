        ' ap-mode-deadlier save-val
        ' ap-mode-familiarEX save-val
        ' ap-mode-rareEX save-val
        ' ap-mode-marathon save-val
        ' ap-mode-kepa save-val
        ' ap-mode-4jerksEX save-val
        ' ap-mode-endless save-val
        ' ap-mode-opp save-val
        ' ap-mode-quickdeath save-val
        ' ap-mode-infection save-val
        ' ap-mode-weather save-val
        ' ap-mode-rpg save-val
        ' ap-mode-scepter save-val
        ' ap-mode-mutation save-val
        ' ap-mode-infectionEX save-val
    save-end
    AP_PROGRESS_FILE $strbuf-write
;

\ Load cumulative progress from external file
: ap-load-progress
    "AP: Loading persistent progress" print
    AP_PROGRESS_FILE filesave{ $load-savefile }
;

\ -----------------------------------------------------------------------------
\ CATCH-UP FUNCTIONS
\ Use these to recover missed milestones without resetting progress
\ Run from console while connected to Archipelago
\ Run ONE catch-up at a time and wait for client to process before next
\ -----------------------------------------------------------------------------

\ Catch-up recruits (1-20, IDs 8001-8020)
: ap-catchup-recruits
    "Catching up recruit milestones..." print
    ap-recruits-done 20 min to ap-temp-kills
    ap-recruits-last-sent ap-temp-kills < if
        ap-recruits-last-sent 1 + to ap-recruits-last-sent
        8000 ap-recruits-last-sent + ap-send-check
        "Sent recruit: " print ap-recruits-last-sent print
        ap-save-progress
    else
        "Nothing to catch up!" print
    then
;

\ Catch-up toilets (1-100, IDs 7001-7100)
: ap-catchup-toilets
    "Catching up toilet milestones..." print
    ap-toilets-opened 100 min to ap-temp-kills
    ap-toilets-last-sent ap-temp-kills < if
        ap-toilets-last-sent 1 + to ap-toilets-last-sent
        7000 ap-toilets-last-sent + ap-send-check
        "Sent toilet: " print ap-toilets-last-sent print
        ap-save-progress
    else
        "Nothing to catch up!" print
    then
;

\ Catch-up containers (1-300, IDs 9001-9300)
: ap-catchup-containers
    "Catching up container milestones..." print
    ap-containers-looted 300 min to ap-temp-kills
    ap-containers-last-sent ap-temp-kills < if
        ap-containers-last-sent 1 + to ap-containers-last-sent
        9000 ap-containers-last-sent + ap-send-check
        "Sent container: " print ap-containers-last-sent print
        ap-save-progress
    else
        "Nothing to catch up!" print
    then
;

\ Catch-up sieges (1-20, IDs 3001-3020)
: ap-catchup-sieges
    "Catching up siege milestones..." print
    ap-sieges-done 20 min to ap-temp-kills
    ap-siege-last-sent ap-temp-kills < if
        ap-siege-last-sent 1 + to ap-siege-last-sent
        3000 ap-siege-last-sent + ap-send-check
        "Sent siege: " print ap-siege-last-sent print
        ap-save-progress
    else
        "Nothing to catch up!" print
    then
;

\ Catch-up weapons (1-100, IDs 4201-4300)
: ap-catchup-weapons
    "Catching up weapon milestones..." print
    ap-weapons-total ap-weapons-collected + 100 min to ap-temp-kills
    ap-weapon-count-last ap-temp-kills < if
        ap-weapon-count-last 1 + to ap-weapon-count-last
        4200 ap-weapon-count-last + ap-send-check
        "Sent weapon: " print ap-weapon-count-last print
        ap-save-progress
    else
        "Nothing to catch up!" print
    then
;

\ Catch-up kills - handles both phases
: ap-catchup-kills
    "Catching up kill milestones..." print
    ap-kills-total road{ kills-this-game } + ap-kills-accumulated - to ap-temp-kills
    "Current kills: " print ap-temp-kills print
    "Last sent: " print ap-kills-last print
    
    0 to ap-temp-id  \ Flag: did we send something?
    
    \ Phase 1: 50-950 (every 50) - IDs 6050-6950
    ap-kills-last 950 < if
        ap-kills-last 50 + ap-temp-kills <= if
            ap-kills-last 50 + to ap-kills-last
            6000 ap-kills-last + ap-send-check
            "Sent kill milestone: " print ap-kills-last print
            ap-save-progress
            1 to ap-temp-id
        then
    then
    
    \ Special: 1000 kills - ID 6999
    ap-temp-id 0 = if
        ap-kills-last 950 = if
            ap-temp-kills 1000 >= if
                1000 to ap-kills-last
                6999 ap-send-check
                "Sent kill milestone: 1000" print
                ap-save-progress
                1 to ap-temp-id
            then
        then
    then
    
    \ Phase 2: 1100-10000 (every 100) - IDs 5011-5100
    ap-temp-id 0 = if
        ap-kills-last 1000 >= if
            ap-kills-last 10000 < if
                ap-kills-last 100 + ap-temp-kills <= if
                    ap-kills-last 100 + to ap-kills-last
                    5000 ap-kills-last 100 / + ap-send-check
                    "Sent kill milestone: " print ap-kills-last print
                    ap-save-progress
                    1 to ap-temp-id
                then
            then
        then
    then
    
    ap-temp-id 0 = if
        "Nothing to catch up!" print
    then
;

\ Info command
: ap-catchup-all
    "=== CATCH-UP COMMANDS ===" print
    "Run these ONE AT A TIME, waiting for client to process each:" print
    "" print
    "  ap-catchup-recruits   - Sends 1 recruit milestone" print
    "  ap-catchup-toilets    - Sends 1 toilet milestone" print
    "  ap-catchup-containers - Sends 1 container milestone" print  
    "  ap-catchup-sieges     - Sends 1 siege milestone" print
    "  ap-catchup-weapons    - Sends 1 weapon milestone" print
    "  ap-catchup-kills      - Sends 1 kill milestone" print
    "" print
    "Keep running each command until it says 'Nothing to catch up'" print
    "======================================" print
;

\ Reset progress file (for starting fresh AP seed)
: ap-reset-progress
    "AP: Resetting ALL persistent progress!" print
    
    \ Global tracking
    0 to ap-kills-total
    0 to ap-kills-accumulated
    0 to ap-weapons-total
    0 to ap-weapons-collected
    0 to ap-toilets-opened
    0 to ap-toilets-last-sent
    0 to ap-recruits-done
    0 to ap-recruits-last-sent
    0 to ap-containers-looted
    0 to ap-containers-last-sent
    0 to ap-sieges-done
    0 to ap-siege-last-sent
    0 to ap-missions-done
    0 to ap-missions-last-sent
    0 to ap-kills-last
    0 to ap-day-last
    0 to ap-day-clear-last
    0 to ap-victory-sent
    0 to ap-found-handgun
    0 to ap-found-rifle
    0 to ap-found-shotgun
    0 to ap-found-blade
    0 to ap-found-explosive
    0 to ap-found-heavy
    0 to ap-found-blunt
    0 to ap-found-flamethrower
    0 to ap-found-minigun
    0 to ap-found-ak47
    0 to ap-found-sledge
    0 to ap-found-fireaxe
    0 to ap-found-bow
    0 to ap-weapon-count-last
    0 to ap-items-received
    
    \ Per-mode tracking reset
    0 to ap-normal-missions  0 to ap-normal-days  0 to ap-normal-days-clear  0 to ap-normal-victory
    0 to ap-familiar-missions  0 to ap-familiar-days  0 to ap-familiar-days-clear  0 to ap-familiar-victory
    0 to ap-rare-missions  0 to ap-rare-days  0 to ap-rare-days-clear  0 to ap-rare-victory
    0 to ap-short-missions  0 to ap-short-days  0 to ap-short-days-clear  0 to ap-short-victory
    0 to ap-long-missions  0 to ap-long-days  0 to ap-long-days-clear  0 to ap-long-victory
    0 to ap-4jerks-missions  0 to ap-4jerks-days  0 to ap-4jerks-days-clear  0 to ap-4jerks-victory
    0 to ap-deadlier-missions  0 to ap-deadlier-days  0 to ap-deadlier-days-clear  0 to ap-deadlier-victory
    0 to ap-familiarEX-missions  0 to ap-familiarEX-days  0 to ap-familiarEX-days-clear  0 to ap-familiarEX-victory
    0 to ap-rareEX-missions  0 to ap-rareEX-days  0 to ap-rareEX-days-clear  0 to ap-rareEX-victory
    0 to ap-marathon-missions  0 to ap-marathon-days  0 to ap-marathon-days-clear  0 to ap-marathon-victory
    0 to ap-kepa-missions  0 to ap-kepa-days  0 to ap-kepa-days-clear  0 to ap-kepa-victory
    0 to ap-4jerksEX-missions  0 to ap-4jerksEX-days  0 to ap-4jerksEX-days-clear  0 to ap-4jerksEX-victory
    0 to ap-endless-missions  0 to ap-endless-days  0 to ap-endless-days-clear  0 to ap-endless-victory
    0 to ap-opp-missions  0 to ap-opp-days  0 to ap-opp-days-clear  0 to ap-opp-victory
    0 to ap-quickdeath-missions  0 to ap-quickdeath-days  0 to ap-quickdeath-days-clear  0 to ap-quickdeath-victory
    0 to ap-infection-missions  0 to ap-infection-days  0 to ap-infection-days-clear  0 to ap-infection-victory
    0 to ap-weather-missions  0 to ap-weather-days  0 to ap-weather-days-clear  0 to ap-weather-victory
    0 to ap-rpg-missions  0 to ap-rpg-days  0 to ap-rpg-days-clear  0 to ap-rpg-victory
    0 to ap-scepter-missions  0 to ap-scepter-days  0 to ap-scepter-days-clear  0 to ap-scepter-victory
    0 to ap-mutation-missions  0 to ap-mutation-days  0 to ap-mutation-days-clear  0 to ap-mutation-victory
    0 to ap-infectionEX-missions  0 to ap-infectionEX-days  0 to ap-infectionEX-days-clear  0 to ap-infectionEX-victory
    
    \ Mode unlock flags reset
    0 to ap-mode-familiar
    0 to ap-mode-rare
    0 to ap-mode-short
    0 to ap-mode-long
    0 to ap-mode-4jerks
    0 to ap-mode-deadlier
    0 to ap-mode-familiarEX
    0 to ap-mode-rareEX
    0 to ap-mode-marathon
    0 to ap-mode-kepa
    0 to ap-mode-4jerksEX
    0 to ap-mode-endless
    0 to ap-mode-opp
    0 to ap-mode-quickdeath
    0 to ap-mode-infection
    0 to ap-mode-weather
    0 to ap-mode-rpg
    0 to ap-mode-scepter
    0 to ap-mode-mutation
    0 to ap-mode-infectionEX
    
    "" AP_OUTBOX $swrite
    ap-save-progress
    
    \ Refresh mode menu to show all modes locked
    gamedef{ modedefs }
    "AP: Progress reset complete. Restart game to see locked modes." print
;

\ Reset state for new session (preserves cumulative progress)
\ NOTE: This is now handled by ap-hook-new-session. This function is for manual console use.
: ap-reset-all
    "AP: Manual reset - preserving cumulative progress" print
    \ NOTE: Kill accumulation now happens in ap-force-save
    \ Just reset per-run tracking here
    0 to ap-kills-accumulated
    \ Add this run's weapons to cumulative total and reset for new run
    ap-weapons-collected ap-weapons-total + to ap-weapons-total
    "Weapons from last run added. Total weapons now: " print ap-weapons-total print
    0 to ap-weapons-collected
    \ Save updated totals
    ap-save-progress
    \ Reset per-run state only
    0 to ap-in-siege
    0 to ap-siege-last-day
    "" AP_OUTBOX $swrite
;

\ -----------------------------------------------------------------------------
\ EVENT HOOKS
\ -----------------------------------------------------------------------------

: ap-hook-mission-start amend main-event-mission-start
    ap-game-active not if then;
    "MISSION-START - day:" print road{ road-trip-days } print
    ap-check-day-start
    ap-check-mode-day-start
    ap-check-inbox
    \ Set flag - will be cleared by mission-end if it fires
    1 to ap-in-siege
;
last to main-event-mission-start

: ap-hook-mission-end amend main-event-mission-end
    ap-game-active not if then;
    ' ap-missions-done ++
    ap-print-stats
    ap-check-mission-milestones
    ap-check-kill-milestones
    ap-check-weapons
    \ Clear flag - this means it was NOT a siege
    0 to ap-in-siege
;
last to main-event-mission-end

: ap-hook-road-resume amend main-event-road-resume
    ap-game-active not if then;
    "ROAD-RESUME - day=" print road{ road-trip-days } print
    \ Force saveslot to 1 for Archipelago saves
    1 saveslot!
    \ Check for day clear (we just finished a day)
    ap-check-day-clear
    ap-check-mode-day-clear
    \ Check weapons on road return too
    ap-check-weapons
    \ Check kills in case mission-end didn't catch them
    ap-check-kill-milestones
    \ Check for items when returning to road
    ap-check-inbox
    \ Force game save - ap-save-progress happens inside ap-force-save AFTER game data is written
    need-to-save
;
last to main-event-road-resume

\ Hook periodic - fires regularly during missions for item delivery
: ap-hook-mission-periodic amend main-event-mission-periodic
    ap-game-active not if then;
    ap-check-inbox
;
last to main-event-mission-periodic

\ Hook road periodic - fires regularly on road map
: ap-hook-road-periodic amend main-event-road-periodic
    ap-game-active not if then;
    ap-check-inbox
;
last to main-event-road-periodic

: ap-hook-road-start amend main-event-road-start
    "ROAD-START FIRED" print
    \ Only activate AP in slot 1 games (not unlocks menu which uses slot 0)
    saveslot 1 = if
        1 to ap-game-active
        "ARCHIPELAGO ACTIVE" ap-notify
    then
;
last to main-event-road-start

: ap-hook-road-end amend main-event-road-end
    "ROAD-END" print
    0 to ap-game-active
;
last to main-event-road-end

\ -----------------------------------------------------------------------------
\ ENHANCED TOILET LOOT - Higher chance for toilets to have loot
\ -----------------------------------------------------------------------------

\ Toilet loot contents based on gnome upgrade level
: ap-toilet-loot-contents
    gstats{ ugnome-toilet }
    case
        0 of 1 LOOT_GAS endof              \ Base: 1 gas
        1 of 2 LOOT_GAS endof              \ Upgrade 1: 2 gas  
        2 of 2 LOOT_BULLET endof           \ Upgrade 2: 2 bullets
        3 of 1 2 rnd LOOT_BULLET endof     \ Upgrade 3: 1-2 bullets
        otherwise 1 2 rnd LOOT_BULLET      \ Upgrade 4: same as 3
    endcase
    loot! amount!
;

\ Loot chance based on gnome upgrade level (much higher than vanilla!)
: ap-toilet-loot-chance
    gstats{ ugnome-toilet }
    case
        0 of 40 endof    \ Base: 40% (was 20%)
        1 of 50 endof    \ Upgrade 1: 50%
        2 of 60 endof    \ Upgrade 2: 60%
        3 of 75 endof    \ Upgrade 3: 75% (was 30%)
        otherwise 90     \ Upgrade 4: 90%
    endcase
;

\ Override the toilet word to include better loot chance
: toilet
    spawn
    0x 1a themed spriteid!
    bbox
    swolebolt-
    openable container ' toilet-loot action!
    15 health!
    rnd5050 if 1 lt .flies! then
    ' breakpipe-event events!
    \ NEW: Apply loot with enhanced chance
    ap-toilet-loot-chance %chance if
        ap-toilet-loot-contents
    then
;

\ -----------------------------------------------------------------------------
\ TOILET HOOK - fires when player loots a toilet
\ -----------------------------------------------------------------------------

: ap-hook-toilet-loot amend on-toilet-loot
    ap-game-active if
        ' ap-toilets-opened ++
        "TOILET OPENED! Total:" print ap-toilets-opened print
        ap-check-toilet-milestones
    then
;
last to on-toilet-loot

\ -----------------------------------------------------------------------------
\ RECRUIT HOOK - fires when player recruits a character
\ -----------------------------------------------------------------------------

: ap-hook-recruited amend on-recruited
    ap-game-active if
        ' ap-recruits-done ++
        "RECRUIT! Total:" print ap-recruits-done print
        ap-check-recruit-milestones
    then
;
last to on-recruited

\ -----------------------------------------------------------------------------
\ CONTAINER LOOT HOOK - fires when player loots any container
\ -----------------------------------------------------------------------------

: ap-hook-container-loot amend on-container-loot
    ap-game-active if
        ' ap-containers-looted ++
        "CONTAINER LOOTED! Total:" print ap-containers-looted print
        ap-check-container-milestones
    then
;
last to on-container-loot

\ -----------------------------------------------------------------------------
\ VICTORY HOOK - fires when player wins the game
\ -----------------------------------------------------------------------------

: ap-hook-victory amend on-victory
    "AP: VICTORY - on-victory fired!" print
    ap-check-victory
    ap-check-mode-victory
;
last to on-victory

\ -----------------------------------------------------------------------------
\ SIEGE COMPLETE HOOK - fires when player survives a siege
\ -----------------------------------------------------------------------------

: ap-hook-siege-complete amend on-siege-complete
    ap-game-active if
        ' ap-sieges-done ++
        "SIEGE COMPLETE! Total:" print ap-sieges-done print
        ap-check-siege-milestones
    then
;
last to on-siege-complete

\ -----------------------------------------------------------------------------
\ SAVE HOOK - only save to persistent file, NOT to game saves
\ This prevents old saves from overwriting newer progress
\ -----------------------------------------------------------------------------
\ NOTE: We do NOT hook on-dumpstate because it runs BEFORE save-slot-data
\ and would corrupt the save buffer. AP progress is saved AFTER game save
\ in ap-force-save.
\ -----------------------------------------------------------------------------

\ -----------------------------------------------------------------------------
\ NEW SESSION HOOK - fires when starting new game
\ -----------------------------------------------------------------------------

: ap-hook-new-session amend main-event-new-session
    "AP: New session started" print
    \ Only do AP stuff if we're in slot 1
    saveslot 1 = not if then;
    \ NOTE: Kill accumulation now happens in ap-force-save before saving
    \ This prevents losing kills when road{ kills-this-game } resets
    
    \ Reset per-run tracking for new run
    0 to ap-kills-accumulated  \ New run starts with 0 kills
    
    \ Add this run's weapons to cumulative total and reset for new run
    ap-weapons-collected ap-weapons-total + to ap-weapons-total
    0 to ap-weapons-collected
    \ Save updated totals
    ap-save-progress
    \ Reset per-run state
    0 to ap-in-siege
    0 to ap-siege-last-day
    "" AP_OUTBOX $swrite
;
last to main-event-new-session

\ -----------------------------------------------------------------------------
\ LOAD HOOK - fires after loading a game save
\ Reload from persistent file to restore correct progress
\ -----------------------------------------------------------------------------

\ Force slot 1 for loading - use the original game-load-continue which handles filesave vocabulary correctly
: ap-game-load-continue
    "AP: === LOADING GAME ===" print
    1 saveslot!
    filesave{ game-load-continue }
    team-count if
        "AP: Load successful! Team size:" print team-count print
        ap-load-progress
        1 to ap-game-active
        "AP: --- ARCHIPELAGO STATS ---" print
        "  Kills (total):" print ap-kills-total print
        "  Kills (accumulated this run):" print ap-kills-accumulated print
        "  Containers:" print ap-containers-looted print
        "  Toilets:" print ap-toilets-opened print
        "  Sieges:" print ap-sieges-done print
        "  Recruits:" print ap-recruits-done print
        "  Missions:" print ap-missions-done print
        "  Items received:" print ap-items-received print
        "AP: --------------------------" print
    then
;
' ap-game-load-continue to main-event-do-load

\ -----------------------------------------------------------------------------
\ FORCE SLOT 1 FOR ALL SAVES
\ Override save-the-game to always use slot 1 for Archipelago
\ -----------------------------------------------------------------------------

: ap-force-save
    "AP: === SAVING GAME ===" print
    1 saveslot!
    filesave{ 
        save-slot-info
        save-start
            dumpchars
            dumpgame
            dumpstate
        save-end
        save-slot-data
        save-global-stats 
    }
    "AP: Game saved to slot 1" print
    \ ACCUMULATE KILLS: Add new kills from this run to total before saving
    road{ kills-this-game } ap-kills-accumulated > if
        road{ kills-this-game } ap-kills-accumulated - ap-kills-total + to ap-kills-total
        road{ kills-this-game } to ap-kills-accumulated
        "AP: Accumulated kills to total" print
    then
    ap-save-progress
    "AP: --- ARCHIPELAGO STATS ---" print
    "  Kills this run:" print road{ kills-this-game } print
    "  Kills accumulated:" print ap-kills-accumulated print
    "  Kills (total):" print ap-kills-total print
    "  Containers:" print ap-containers-looted print
    "  Toilets:" print ap-toilets-opened print
    "  Sieges:" print ap-sieges-done print
    "  Recruits:" print ap-recruits-done print
    "  Missions:" print ap-missions-done print
    "  Items received:" print ap-items-received print
    "AP: === SAVE COMPLETE ===" print
;
' ap-force-save to save-the-game

\ -----------------------------------------------------------------------------
\ INITIALIZATION
\ -----------------------------------------------------------------------------

"" AP_INBOX $swrite
"" AP_OUTBOX $swrite

\ Try to load persistent progress on mod load
ap-load-progress

"Archipelago mod v3.6 loaded" print
"  - Use the ARCHIPELAGO menu option!" print
"  - Progress persists across deaths" print
"  - Kill tracking now persists properly!" print
"  - Type 'ap-reset-progress' in console to start fresh" print

\ -----------------------------------------------------------------------------
\ GAME MODE UNLOCKS - Override modedefs to use our AP unlock flags
\ Variables are defined at top of file, this just overrides the mode menu
\ -----------------------------------------------------------------------------

\ Override modedefs to use our AP unlock flags
gamedef{
: modedefs init
    \ Check for items whenever mode menu is shown (loop to process multiple pending items)
    25 for ap-check-inbox next
    \ Save progress after processing items (to persist mode unlocks)
    ap-save-progress
    
    ($ "Death Road Normal Mode" .. WINSNORM $) $mode
        ($ "The normal, default game mode.
        Get your skis, pack a toque... we're going to CANADA!
        Most road recruits you find will be random, but sometimes you'll be more lucky." $) $desc
        MODE_ICONS 0 + icon
        ' defaultmode applyword
        
    ($ "Familiar Characters Mode" .. WINSFAM $) $mode
        "Most road recruits you meet are now familiar characters, instead of random!
        These are characters that you've created and saved. Make your friends and family, and they'll show up in the game!" $desc
        MODE_ICONS 0x 8 + icon
        ' familiarchars applyword
        ap-mode-familiar not if 1 locked
        "[ARCHIPELAGO] Locked until received from multiworld." $desc
        then
    
    ($ "Rare Characters Mode" .. WINSRARE $) $mode
        "Most road recruits you meet are now special characters with unique abilities!
        This usually can make things a little easier.
        But not always." $desc
        MODE_ICONS 0x 3 + icon
        ' specialchars applyword
        ap-mode-rare not if 1 locked
        "[ARCHIPELAGO] Locked until received from multiworld." $desc
        then
        
    ($ "Short Trip to Heck Mode" .. WINSSHORT $) $mode
        "For impatient people that want a risky shortcut!
        It takes 9 driving days to get to Canada, rather than the default 15 days.
        Be careful, this means less days to prepare for the end!" $desc
        MODE_ICONS 0x 1 + icon
        ' shortroad applyword
        ap-mode-short not if 1 locked
        "[ARCHIPELAGO] Locked until received from multiworld." $desc
        then
        
    ($ "Long Winding Road Mode" .. WINSLONG $) $mode
        "For people that like to chill and take it easy.
        It takes 25 driving days to get to Canada, rather than the usual 15 days.
        Difficulty progression starts the same, but gets higher! At least you get more time to prepare." $desc
        MODE_ICONS 0x 2 + icon
        ' longroad applyword
        ap-mode-long not if 1 locked
        "[ARCHIPELAGO] Locked until received from multiworld." $desc
        then

    ($ "Four Jerks Mode" .. WINS4JERKS $) $mode
        "Start with up to 4 people, if you made Custom Characters!
        Made for 4 player co-op, or if you just want a full car at start.
        In exchange, about 15% more zombies will spawn." $desc
        MODE_ICONS 0x 5 + icon
        ' 4jerksmode applyword
        ap-mode-4jerks not if 1 locked
        "[ARCHIPELAGO] Locked until received from multiworld." $desc
        then
        
    ($ "Deadlier Road Mode" .. WINSDEADLY $) $mode
        "30% more danger! 30% more excitement!
        About 30% more zombies.
        Bandits are more cruel." $desc
        MODE_ICONS 0x 4 + icon
        ' deadlier applyword
        ap-mode-deadlier not if 1 locked
        "[ARCHIPELAGO] Locked until received from multiworld." $desc
        then
        
    ($ "Familiar " .. RAINBOW .. "EXTREME" .. WHITE .. WINSFAMEX $) $mode
        "Most recruits you meet are familiar characters!
        Make sure your custom characters are strong and work together well, because they will be facing 60% more the usual amount of zombies.
        Bandits are more cruel." $desc
        MODE_ICONS 0x a + icon
        ' familiarcharsEX applyword
        ap-mode-familiarEX not if 1 locked
        "[ARCHIPELAGO] Locked until received from multiworld." $desc
        then
                
    ($ "Rare " .. RAINBOW .. "EXTREME" .. WHITE .. WINSRAREEX $) $mode
        "Most recruits you meet are special characters!
        This is combined with the amount of zombies set to 60% more than usual. Can the unique characters you find survive gigantic walls of undead?
        Bandits are more cruel." $desc
        MODE_ICONS 0x 6 + icon
        ' specialcharsEX applyword
        ap-mode-rareEX not if 1 locked
        "[ARCHIPELAGO] Locked until received from multiworld." $desc
        then
        
    ($ "Marathon" fbold .. " Mode" .. WINSMARATHON $) $mode
        "A grueling challenge.
        It takes 30 driving days to get to Canada, rather than the usual 15 days. About a month of pain!
        Zombie amount starts off 50% higher than normal, and eventually goes to double. 
        Bandits are more cruel." $desc
        MODE_ICONS 0x 9 + icon
        ' marathonmode applyword
        ap-mode-marathon not if 1 locked
        "[ARCHIPELAGO] Locked until received from multiworld." $desc
        then
        
    ($ "K*E*P*A " fbold .. "MODE" .. WINSKEPA $) $mode
        "Kepa Expert Player Advanced Mode.
        Double the zombies, double the fun.
        Start with a Kepa. Do NOT let Kepa die. The ultimate challenge.
        Bandits are more cruel." $desc
        MODE_ICONS 0x 5 + icon
        ' kepamode applyword
        ap-mode-kepa not if 1 locked
        "[ARCHIPELAGO] Locked until received from multiworld." $desc
        then
        
    ($ "Four Jerks " .. RAINBOW .. "EXTREME" .. WHITE .. WINS4JERKSEX $) $mode
        "Start with a car full of jerks, now with more zombies!
        About 100% more zombies will spawn, and the Final showdown will have twice as many zombies as normal! Double Deluxe!
        Bandits are more cruel." $desc
        MODE_ICONS 0x 5 + icon
        ' 4jerksmodeEX applyword
        ap-mode-4jerksEX not if 1 locked
        "[ARCHIPELAGO] Locked until received from multiworld." $desc
        then
        
    ($ "ENDLESS " fbold .. "MODE" .. WINSENDLESS $) $mode
        "Canada is a myth perpetuated by the former government!
        America extends northward forever! Wake up sheeple!!!
        Travel forever-ish. See how far you can get.
        Bandits are more cruel." $desc
        MODE_ICONS 0x 5 + icon
        ' endlessmode applyword
        ap-mode-endless not if 1 locked
        "[ARCHIPELAGO] Locked until received from multiworld." $desc
        then
        
    ($ "O*P*P " rainbold .. "MODE" .. WINSOPP $) $mode
        "Over Powered Party! Final showdown is twice as long!
        Get a special start that lets you pick any special characters you want and other goodies!
        Fight Triple the default zombie amount!! Bandits are more cruel. Wins here do not count towards streaks." $desc
        MODE_ICONS 0x 3 + icon
        ' OPPmode applyword
        ap-mode-opp not if 1 locked
        "[ARCHIPELAGO] Locked until received from multiworld." $desc
        then
        
    ($ "Quick Death " fbold .. "MODE" .. WINSQUICKDEATH $) $mode
        "For anyone that wants to die FAST!
        It only takes 9 driving days to get to Canada!
        Triple the default zombie amount!!
        Bandits are more cruel." $desc
        MODE_ICONS 0x 1 + icon
        ' quicknightmare applyword
        ap-mode-quickdeath not if 1 locked
        "[ARCHIPELAGO] Locked until received from multiworld." $desc
        then
        
    ($ "INFECTION " pbold .. "MODE" .. WINS_INFECTION  $) $mode
        "Race to Canada before your immunity expires. 
        > In-mission timer ticks down; 10 days to Canada
        > Timer can be increased by killing zombies
        > If the timer runs out, you die - no refunds!
        > Earned time is counted post-mission
        > Cruel bandits" $desc
        MODE_ICONS 32 + icon
        ' theinfection applyword
        ap-mode-infection not if 1 locked
        "[ARCHIPELAGO] Locked until received from multiworld." $desc
        then
        
    ($ "SEVERE WEATHER MODE" bbold .. "" .. WINS_WEATHER  $) $mode
        "''Winter is coming'' IT'S ALREADY HERE, DINK!
        > EXTREME WEATHER! Lightning, frost, floods!
        > All chars eat an additional 1 food/night for warmth 
        > 15 days, 1x zombies, cruel bandits 
        > More engine issues
        > (Don't) Stay Frosty!" $desc
        MODE_ICONS 33 + icon
        ' weathermode applyword
        ap-mode-weather not if 1 locked
        "[ARCHIPELAGO] Locked until received from multiworld." $desc
        then
        
     ($ "RPG MODE" rainbold .. "" .. WINS_RPG $) $mode
        "Die of dysentry. Just kidding. 
        > Zombies drop powerups!
        > Select from 8 subclasses to play as!
        > 3x zombs, cruel bandits, 15 days  
        > Start with 2 bonus random chars" $desc
        MODE_ICONS 34 + icon
        ' thelongsiege applyword
        ap-mode-rpg not if 1 locked
        "[ARCHIPELAGO] Locked until received from multiworld." $desc
        then 
        
    ($ "Four Jerks" .. ORANGE .. " SCEPTER" .. WHITE WINS_SCEPTER .. $) $mode
        ($ "> Choose 4 custom characters to start!
            > Gain access to an upgrade for each character!
            > 3x zombs, 12 days, cruel bandits 
            > Choose your contingent wisely! 
            > Engineered for fun 
        " .. GREEN .. "''No Sorcery Lies Beyond My Grasp.''" .. WHITE $) $desc
        MODE_ICONS 35 + icon
        ' sceptermode applyword
        ap-mode-scepter not if 1 locked
        "[ARCHIPELAGO] Locked until received from multiworld." $desc
        then 
        
    ($ "MUTATION " rainbold .. "MODE" .. "" WINS_MUTATION .. $) $mode
        "They're back - and they're MEGABUFF. 
        > 15 days, 1x zombies 
        > As days pass, zombs become resistant...
        > Zombies gain fire resist, mass and grapple strengh!
        > Winning raises max ZP by 5! 
        > Cruel bandits" $desc
        MODE_ICONS 36 + icon
        ' mutationmode applyword
        ap-mode-mutation not if 1 locked
        "[ARCHIPELAGO] Locked until received from multiworld." $desc
        then
        
    ($ "INFECTION " pbold .. "MODE" .. " EXTREME" rainbold WINS_INFECTIONEX .. $) $mode
        "The race to Canada is shorter than ever.
        > Same ruleset as normal INFECTION 
        > Now even shorter - only 7 days! 
        > 10 minutes of total mission time!
        > Cruel bandits" $desc
        MODE_ICONS 37 + icon
        ' theinfectionEX applyword
        ap-mode-infectionEX not if 1 locked
        "[ARCHIPELAGO] Locked until received from multiworld." $desc
        then
        
;

\ Re-run modedefs to apply our locked versions
modedefs
}

\ Add ARCHIPELAGO option to main menu
cyoa{
    \ Handler for starting NEW archipelago game
    cyoa-choice: ap-start-new
        1 saveslot!
        to-gamestart-setup
    ;
    
    \ Handler for actually loading the game (after confirmation)
    cyoa-choice: ap-do-load
        1 saveslot!
        gogo
        1 saveslot!
        MAIN_EVENT_DO_LOAD main-post-event
    ;
    
    \ Confirmation screen before continuing (matches original game flow)
    cyoa: ap-continue-confirm make-it-snappy
        "- CONTINUE GAME -" cyoa-title!
        "THE HORROR CONTINUES..." cyoa-text!
        choice( "YIKES" )choice: ap-do-load
    ;
    
    \ Handler for CONTINUING archipelago game - shows confirmation first
    cyoa-choice: ap-continue-game
        1 saveslot!
        ap-continue-confirm
    ;
    
    \ Archipelago sub-menu - shows continue only if save exists
    cyoa: ap-game-menu make-it-snappy
        load-slotinfo
        "- ARCHIPELAGO -" cyoa-title!
        "Archipelago uses Save Slot 1.\nProgress persists across deaths!" cyoa-text!
        1 slot? if
            choice( "CONTINUE GAME" )choice: ap-continue-game
        then
        choice( "NEW GAME" )choice: ap-start-new
        choice( "BACK" )choice: select-start backicon
    ;
    
    \ Handler for archipelago button
    cyoa-choice: ap-start-game
        ap-game-menu
    ;
    
    \ Handler for reset confirmation
    cyoa-choice: ap-do-reset
        ap-reset-progress
        "AP Progress has been reset!" print
        select-start
    ;
    
    \ Reset confirmation screen
    cyoa: ap-reset-confirm make-it-snappy
        "- RESET ARCHIPELAGO -" cyoa-title!
        "This will DELETE all your Archipelago progress!\n\nKills, locations, containers, toilets, sieges, recruits - ALL RESET!\n\nAre you sure?" cyoa-text!
        choice( "YES - RESET EVERYTHING" )choice: ap-do-reset
        choice( "NO - GO BACK" )choice: select-start backicon
    ;
    
    \ Handler for reset button
    cyoa-choice: ap-reset-menu
        ap-reset-confirm
    ;

    \ Our custom menu with ARCHIPELAGO option
    cyoa: ap-main-menu make-it-snappy
        load-slotinfo
        filesave{ ' delete-game } to delete-the-game
        "- SELECT -" cyoa-title!
        "Choose game option:" cyoa-text!
        
        \ Add ARCHIPELAGO option first
        choice( "*** ARCHIPELAGO ***" )choice: ap-start-game
        
        slotcount if
            choice( "Continue Game" )choice: select-cont-game
        then
        choice( "New Game" )choice: select-new-game
        choice( "Custom Characters" )choice: do-char-maker
        choice( "Reset AP Progress" )choice: ap-reset-menu
        choice( "BACK" )choice backicon cyoa-choice-esc-default
    ;

    \ Override the main entry point
    : ap-do-select
        gstats{ load }
        gamedef{ modedefs }
        gstats{ tutorial-done } if ap-main-menu then;
        ' noop to delete-the-game
        0 saveslot! MAIN_EVENT_NEW main-post-event "events/tutorial.df" $load-region to-mission
    ;
    
    \ Override slotchoices-new to hide slot 1 (reserved for Archipelago)
    : slotchoices-new 0 args( slot )
        load-slotinfo
        2 for
            3 i - -> slot  \ This gives us slots 3, 2 (skipping when i=2 which is slot 1)
            <- slot 1 = if else
                choice( "empty" )choice: new-gamestart circleicon
                <- slot slot? if
                    slotinfo <- slot peek cyoa-choice-text! drop
                    icons16_id ICON_UP + cyoa-choice-iconid!
                    ballicon
                    ' new-delete-game cyoa-choice-handler!
                then
                <- slot cyoa-choice-num!
            then
        next
    ;
    
    \ Override slotchoices-cont to hide slot 1 (reserved for Archipelago)
    : slotchoices-cont 0 args( slot )
        load-slotinfo
        2 for
            3 i - -> slot
            <- slot 1 = if else
                <- slot slot? if
                    choice( "..." )choice: cont-saveslot circleicon
                    slotinfo <- slot peek cyoa-choice-text! drop
                    <- slot cyoa-choice-num!
                    ballicon
                then
            then
        next
    ;
    
    \ Set it as the event handler
    ' ap-do-select to main-event-do-select
}

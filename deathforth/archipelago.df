\ -----------------------------------------------------------------------------
\ MODE DETECTION HELPER
\ Returns a string identifier for current mode for location naming
\ -----------------------------------------------------------------------------

: ap-current-mode-id
    gamedef{ ' defaultmode gamemode? } if "normal" then
    gamedef{ ' familiarchars gamemode? } if "familiar" then
    gamedef{ ' specialchars gamemode? } if "rare" then
    gamedef{ ' shortroad gamemode? } if "short" then
    gamedef{ ' longroad gamemode? } if "long" then
    gamedef{ ' 4jerksmode gamemode? } if "4jerks" then
    gamedef{ ' deadlier gamemode? } if "deadlier" then
    gamedef{ ' familiarcharsEX gamemode? } if "familiarEX" then
    gamedef{ ' specialcharsEX gamemode? } if "rareEX" then
    gamedef{ ' marathonmode gamemode? } if "marathon" then
    gamedef{ ' kepamode gamemode? } if "kepa" then
    gamedef{ ' 4jerksmodeEX gamemode? } if "4jerksEX" then
    gamedef{ ' endlessmode gamemode? } if "endless" then
    gamedef{ ' OPPmode gamemode? } if "opp" then
    gamedef{ ' quicknightmare gamemode? } if "quickdeath" then
    gamedef{ ' theinfection gamemode? } if "infection" then
    gamedef{ ' weathermode gamemode? } if "weather" then
    gamedef{ ' thelongsiege gamemode? } if "rpg" then
    gamedef{ ' sceptermode gamemode? } if "scepter" then
    gamedef{ ' mutationmode gamemode? } if "mutation" then
    gamedef{ ' theinfectionEX gamemode? } if "infectionEX" then
    "unknown"
;

\ -----------------------------------------------------------------------------
\ FILE PATHS
\ -----------------------------------------------------------------------------

: AP_INBOX savename-prefix "ap_inbox.txt" .. ;
: AP_OUTBOX savename-prefix "ap_outbox.txt" .. ;
: AP_GOAL savename-prefix "ap_goal.txt" .. ;

\ -----------------------------------------------------------------------------
\ NOTIFICATIONS
\ -----------------------------------------------------------------------------

\ Message slot for staggered display
0 value ap-msg-slot

: ap-notify ( msg -- )
    \ Cycle through 4 vertical positions to avoid overlap
    \ 180 ticks = 3 seconds at 60fps
    ap-msg-slot 4 %
    case
        0 of 180 view_w 2 / view_h 0.10 * msgtickxy endof
        1 of 180 view_w 2 / view_h 0.16 * msgtickxy endof
        2 of 180 view_w 2 / view_h 0.22 * msgtickxy endof
        3 of 180 view_w 2 / view_h 0.28 * msgtickxy endof
    endcase
    ' ap-msg-slot ++
;

: ap-notify-item ( msg -- )
    180 view_w 2 / view_h 0.40 * msgtickxy
;

\ -----------------------------------------------------------------------------
\ WEAPON TRACKING OVERRIDE
\ Override trunk.weapon+ to track all weapons added to trunk
\ -----------------------------------------------------------------------------

\ Save reference to original trunk.weapon+ 
' trunk.weapon+ value ap-original-trunk-weapon+

\ New trunk.weapon+ that tracks pickups
: trunk.weapon+ ( count weapon-id -- )
    2dup ap-original-trunk-weapon+ execute  \ Call original
    drop                                      \ Drop weapon-id, keep count
    ap-weapons-collected + to ap-weapons-collected  \ Add count to collected
;


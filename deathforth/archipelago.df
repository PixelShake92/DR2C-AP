\ -----------------------------------------------------------------------------
\ FILE I/O
\ -----------------------------------------------------------------------------

: ap-check-inbox
    AP_INBOX $sread if
        to ap-cmd
        ap-cmd "" $= not if
            ap-dispatch
        then
        "" AP_INBOX $swrite
    then
;

: ap-send-check ( id -- )
    to ap-temp-id
    \ Append to existing content with comma separator
    AP_OUTBOX $sread if
        ($ swap "," .. ap-temp-id .. $) AP_OUTBOX $swrite
    else
        ($ "" ap-temp-id .. $) AP_OUTBOX $swrite
    then
;

\ -----------------------------------------------------------------------------
\ DAY START CHECK (on mission start - sends when entering a new day)
\ -----------------------------------------------------------------------------

0 value ap-victory-sent

\ Note: ap-check-mode-day-start and ap-check-mode-victory are defined after ap-mode-location

: ap-check-day-start
    road{ road-trip-days } to ap-temp-day
    ap-temp-day 15 > if 15 to ap-temp-day then
    ap-temp-day ap-day-last > if
        ap-temp-day to ap-day-last
        \ Global day tracking (legacy)
        ap-day-last 1000 + ap-send-check
        ($ "Day " ap-day-last .. " Start" .. $) ap-notify
    then
;

\ -----------------------------------------------------------------------------
\ DAY CLEAR CHECK (when day countdown hits 0 / moving to next day)
\ -----------------------------------------------------------------------------

: ap-check-day-clear
    road{ road-trip-days } to ap-temp-day
    ap-temp-day 1 - to ap-temp-day
    ap-temp-day 15 > if 15 to ap-temp-day then
    ap-temp-day 0 > if
        ap-temp-day ap-day-clear-last > if
            ap-temp-day to ap-day-clear-last
            \ Global day clear (legacy)
            ap-day-clear-last 1100 + ap-send-check
            ($ "Day " ap-day-clear-last .. " Clear" .. $) ap-notify
        then
    then
;

\ -----------------------------------------------------------------------------
\ VICTORY CHECK
\ -----------------------------------------------------------------------------

: ap-check-victory
    \ Only trigger victory if we haven't sent it yet
    ap-victory-sent not if
        "VICTORY TRIGGERED!" print
        \ Global victory (legacy)
        1020 ap-send-check
        "CANADA REACHED!" ap-notify
        "GOAL COMPLETE!" ap-notify
        \ Write goal completion file for client
        "1" AP_GOAL $swrite
        1 to ap-victory-sent
    then
;

\ Victory is checked in road-end hook below

\ -----------------------------------------------------------------------------
\ PER-MODE TRACKING FUNCTIONS
\ Location ID scheme for per-mode:
\   Base 10000 + (mode_id * 100) + location_type
\   mode_id: 0=normal, 1=familiar, 2=rare, 3=short, 4=long, 5=4jerks, 
\            6=deadlier, 7=familiarEX, 8=rareEX, 9=marathon, 10=kepa,
\            11=4jerksEX, 12=endless, 13=opp, 14=quickdeath, 15=infection,
\            16=weather, 17=rpg, 18=scepter, 19=mutation, 20=infectionEX
\   location_type: 1-30 = day start, 31-60 = mission, 99 = victory
\ -----------------------------------------------------------------------------

\ Get numeric mode ID for location calculation
: ap-mode-num
    gamedef{ ' defaultmode gamemode? } if 0 then;
    gamedef{ ' familiarchars gamemode? } if 1 then;
    gamedef{ ' specialchars gamemode? } if 2 then;
    gamedef{ ' shortroad gamemode? } if 3 then;
    gamedef{ ' longroad gamemode? } if 4 then;
    gamedef{ ' 4jerksmode gamemode? } if 5 then;
    gamedef{ ' deadlier gamemode? } if 6 then;
    gamedef{ ' familiarcharsEX gamemode? } if 7 then;
    gamedef{ ' specialcharsEX gamemode? } if 8 then;
    gamedef{ ' marathonmode gamemode? } if 9 then;
    gamedef{ ' kepamode gamemode? } if 10 then;
    gamedef{ ' 4jerksmodeEX gamemode? } if 11 then;
    gamedef{ ' endlessmode gamemode? } if 12 then;
    gamedef{ ' OPPmode gamemode? } if 13 then;
    gamedef{ ' quicknightmare gamemode? } if 14 then;
    gamedef{ ' theinfection gamemode? } if 15 then;
    gamedef{ ' weathermode gamemode? } if 16 then;
    gamedef{ ' thelongsiege gamemode? } if 17 then;
    gamedef{ ' sceptermode gamemode? } if 18 then;
    gamedef{ ' mutationmode gamemode? } if 19 then;
    gamedef{ ' theinfectionEX gamemode? } if 20 then;
    0
;

\ Calculate location ID: 10000 + (mode * 100) + offset
: ap-mode-location ( offset -- location_id )
    ap-mode-num 100 * 10000 + +
;

\ Check and update per-mode day tracking
: ap-check-mode-day-start
    road{ road-trip-days } to ap-temp-day
    
    \ Normal mode
    gamedef{ ' defaultmode gamemode? } if
        ap-temp-day ap-normal-days > if
            ap-temp-day to ap-normal-days
            ap-temp-day ap-mode-location ap-send-check
            ($ "[Normal] Day " ap-temp-day .. $) ap-notify
        then
    then
    
    \ Familiar mode
    gamedef{ ' familiarchars gamemode? } if
        ap-temp-day ap-familiar-days > if
            ap-temp-day to ap-familiar-days
            ap-temp-day ap-mode-location ap-send-check
            ($ "[Familiar] Day " ap-temp-day .. $) ap-notify
        then
    then
    
    \ Rare mode
    gamedef{ ' specialchars gamemode? } if
        ap-temp-day ap-rare-days > if
            ap-temp-day to ap-rare-days
            ap-temp-day ap-mode-location ap-send-check
            ($ "[Rare] Day " ap-temp-day .. $) ap-notify
        then
    then
    
    \ Short mode
    gamedef{ ' shortroad gamemode? } if
        ap-temp-day ap-short-days > if
            ap-temp-day to ap-short-days
            ap-temp-day ap-mode-location ap-send-check
            ($ "[Short] Day " ap-temp-day .. $) ap-notify
        then
    then
    
    \ Long mode
    gamedef{ ' longroad gamemode? } if
        ap-temp-day ap-long-days > if
            ap-temp-day to ap-long-days
            ap-temp-day ap-mode-location ap-send-check
            ($ "[Long] Day " ap-temp-day .. $) ap-notify
        then
    then
    
    \ 4 Jerks mode
    gamedef{ ' 4jerksmode gamemode? } if
        ap-temp-day ap-4jerks-days > if
            ap-temp-day to ap-4jerks-days
            ap-temp-day ap-mode-location ap-send-check
            ($ "[4Jerks] Day " ap-temp-day .. $) ap-notify
        then
    then
    
    \ Deadlier mode
    gamedef{ ' deadlier gamemode? } if
        ap-temp-day ap-deadlier-days > if
            ap-temp-day to ap-deadlier-days
            ap-temp-day ap-mode-location ap-send-check
            ($ "[Deadlier] Day " ap-temp-day .. $) ap-notify
        then
    then
    
    \ Familiar EXTREME mode
    gamedef{ ' familiarcharsEX gamemode? } if
        ap-temp-day ap-familiarEX-days > if
            ap-temp-day to ap-familiarEX-days
            ap-temp-day ap-mode-location ap-send-check
            ($ "[FamiliarEX] Day " ap-temp-day .. $) ap-notify
        then
    then
    
    \ Rare EXTREME mode
    gamedef{ ' specialcharsEX gamemode? } if
        ap-temp-day ap-rareEX-days > if
            ap-temp-day to ap-rareEX-days
            ap-temp-day ap-mode-location ap-send-check
            ($ "[RareEX] Day " ap-temp-day .. $) ap-notify
        then
    then
    
    \ Marathon mode
    gamedef{ ' marathonmode gamemode? } if
        ap-temp-day ap-marathon-days > if
            ap-temp-day to ap-marathon-days
            ap-temp-day ap-mode-location ap-send-check
            ($ "[Marathon] Day " ap-temp-day .. $) ap-notify
        then
    then
    
    \ KEPA mode
    gamedef{ ' kepamode gamemode? } if
        ap-temp-day ap-kepa-days > if
            ap-temp-day to ap-kepa-days
            ap-temp-day ap-mode-location ap-send-check
            ($ "[KEPA] Day " ap-temp-day .. $) ap-notify
        then
    then
    
    \ 4 Jerks EXTREME mode
    gamedef{ ' 4jerksmodeEX gamemode? } if
        ap-temp-day ap-4jerksEX-days > if
            ap-temp-day to ap-4jerksEX-days
            ap-temp-day ap-mode-location ap-send-check
            ($ "[4JerksEX] Day " ap-temp-day .. $) ap-notify
        then
    then
    
    \ Endless mode
    gamedef{ ' endlessmode gamemode? } if
        ap-temp-day ap-endless-days > if
            ap-temp-day to ap-endless-days
            ap-temp-day ap-mode-location ap-send-check
            ($ "[Endless] Day " ap-temp-day .. $) ap-notify
        then
    then
    
    \ OPP mode
    gamedef{ ' OPPmode gamemode? } if
        ap-temp-day ap-opp-days > if
            ap-temp-day to ap-opp-days
            ap-temp-day ap-mode-location ap-send-check
            ($ "[OPP] Day " ap-temp-day .. $) ap-notify
        then
    then
    
    \ Quick Death mode
    gamedef{ ' quicknightmare gamemode? } if
        ap-temp-day ap-quickdeath-days > if
            ap-temp-day to ap-quickdeath-days
            ap-temp-day ap-mode-location ap-send-check
            ($ "[QuickDeath] Day " ap-temp-day .. $) ap-notify
        then
    then
    
    \ Infection mode
    gamedef{ ' theinfection gamemode? } if
        ap-temp-day ap-infection-days > if
            ap-temp-day to ap-infection-days
            ap-temp-day ap-mode-location ap-send-check
            ($ "[Infection] Day " ap-temp-day .. $) ap-notify
        then
    then
    
    \ Weather mode
    gamedef{ ' weathermode gamemode? } if
        ap-temp-day ap-weather-days > if
            ap-temp-day to ap-weather-days
            ap-temp-day ap-mode-location ap-send-check
            ($ "[Weather] Day " ap-temp-day .. $) ap-notify
        then
    then
    
    \ RPG mode
    gamedef{ ' thelongsiege gamemode? } if
        ap-temp-day ap-rpg-days > if
            ap-temp-day to ap-rpg-days
            ap-temp-day ap-mode-location ap-send-check
            ($ "[RPG] Day " ap-temp-day .. $) ap-notify
        then
    then
    
    \ Scepter mode
    gamedef{ ' sceptermode gamemode? } if
        ap-temp-day ap-scepter-days > if
            ap-temp-day to ap-scepter-days
            ap-temp-day ap-mode-location ap-send-check
            ($ "[Scepter] Day " ap-temp-day .. $) ap-notify
        then
    then
    
    \ Mutation mode
    gamedef{ ' mutationmode gamemode? } if
        ap-temp-day ap-mutation-days > if
            ap-temp-day to ap-mutation-days
            ap-temp-day ap-mode-location ap-send-check
            ($ "[Mutation] Day " ap-temp-day .. $) ap-notify
        then
    then
    
    \ Infection EXTREME mode
    gamedef{ ' theinfectionEX gamemode? } if
        ap-temp-day ap-infectionEX-days > if
            ap-temp-day to ap-infectionEX-days
            ap-temp-day ap-mode-location ap-send-check
            ($ "[InfectionEX] Day " ap-temp-day .. $) ap-notify
        then
    then
;

\ -----------------------------------------------------------------------------
\ PER-MODE DAY CLEAR CHECK
\ Location ID: 10000 + (mode_id * 100) + 30 + day (offset 31-60 for day clear)
\ -----------------------------------------------------------------------------

: ap-check-mode-day-clear
    road{ road-trip-days } to ap-temp-day
    ap-temp-day 1 - to ap-temp-day
    ap-temp-day 0 > if
        \ Normal mode
        gamedef{ ' defaultmode gamemode? } if
            ap-temp-day ap-normal-days-clear > if
                ap-temp-day to ap-normal-days-clear
                ap-temp-day 30 + ap-mode-location ap-send-check
                ($ "[Normal] Day " ap-temp-day .. " Clear" .. $) ap-notify
            then
        then
        
        \ Familiar mode
        gamedef{ ' familiarchars gamemode? } if
            ap-temp-day ap-familiar-days-clear > if
                ap-temp-day to ap-familiar-days-clear
                ap-temp-day 30 + ap-mode-location ap-send-check
                ($ "[Familiar] Day " ap-temp-day .. " Clear" .. $) ap-notify
            then
        then
        
        \ Rare mode

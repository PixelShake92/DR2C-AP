\ ITEM HANDLERS
\ -----------------------------------------------------------------------------

\ === RESOURCES ===
: ap-item-100 5 trunk-food+ "AP: +5 Food" ap-notify-item ;
: ap-item-101 15 trunk-food+ "AP: +15 Food" ap-notify-item ;
: ap-item-102 
    "GAS BEFORE:" print trunk-gas print
    50 trunk-gas+ 
    "GAS AFTER:" print trunk-gas print
    "AP: +50 Gas" ap-notify-item 
;
: ap-item-103 20 trunk-bullet+ "AP: +20 Ammo" ap-notify-item ;
: ap-item-104 5 trunk-medical+ "AP: +5 Medical" ap-notify-item ;


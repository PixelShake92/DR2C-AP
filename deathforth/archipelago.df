\ -----------------------------------------------------------------------------
\ MISSION MILESTONE CHECKS
\ -----------------------------------------------------------------------------

: ap-check-mission-milestones
    \ Send check for current location count
    ap-missions-done ap-missions-last-sent > if
        ap-missions-done 320 <= if
            2000 ap-missions-done + ap-send-check
            ($ "Location " ap-missions-done .. "!" .. $) ap-notify
            ap-missions-done to ap-missions-last-sent
        then
    then
;

\ -----------------------------------------------------------------------------
\ KILL MILESTONE CHECKS
\ -----------------------------------------------------------------------------

: ap-check-kill-milestones
    \ Calculate cumulative kills: 
    \ ap-kills-total already includes accumulated kills from this run
    \ Add only the NEW kills since last accumulation
    ap-kills-total road{ kills-this-game } + ap-kills-accumulated - to ap-temp-kills
    \ Check each milestone explicitly - send if reached and not already sent
    \ Kills 50-1000: IDs 6050-6999 (every 50)
    \ Kills 1100-11000: IDs 5011-5110 (every 100, ID = 5000 + kills/100)
    
    \ === 50-1000 kills (every 50) ===
    ap-kills-last 50 < if ap-temp-kills 50 >= if 
        6050 ap-send-check "Kills 50!" ap-notify 50 to ap-kills-last 
    then then
    ap-kills-last 100 < if ap-temp-kills 100 >= if 
        6100 ap-send-check "Kills 100!" ap-notify 100 to ap-kills-last 
    then then
    ap-kills-last 150 < if ap-temp-kills 150 >= if 
        6150 ap-send-check "Kills 150!" ap-notify 150 to ap-kills-last 
    then then
    ap-kills-last 200 < if ap-temp-kills 200 >= if 
        6200 ap-send-check "Kills 200!" ap-notify 200 to ap-kills-last 
    then then
    ap-kills-last 250 < if ap-temp-kills 250 >= if 
        6250 ap-send-check "Kills 250!" ap-notify 250 to ap-kills-last 
    then then
    ap-kills-last 300 < if ap-temp-kills 300 >= if 
        6300 ap-send-check "Kills 300!" ap-notify 300 to ap-kills-last 
    then then
    ap-kills-last 350 < if ap-temp-kills 350 >= if 
        6350 ap-send-check "Kills 350!" ap-notify 350 to ap-kills-last 
    then then
    ap-kills-last 400 < if ap-temp-kills 400 >= if 
        6400 ap-send-check "Kills 400!" ap-notify 400 to ap-kills-last 
    then then
    ap-kills-last 450 < if ap-temp-kills 450 >= if 
        6450 ap-send-check "Kills 450!" ap-notify 450 to ap-kills-last 
    then then
    ap-kills-last 500 < if ap-temp-kills 500 >= if 
        6500 ap-send-check "Kills 500!" ap-notify 500 to ap-kills-last 
    then then
    ap-kills-last 550 < if ap-temp-kills 550 >= if 
        6550 ap-send-check "Kills 550!" ap-notify 550 to ap-kills-last 
    then then
    ap-kills-last 600 < if ap-temp-kills 600 >= if 
        6600 ap-send-check "Kills 600!" ap-notify 600 to ap-kills-last 
    then then
    ap-kills-last 650 < if ap-temp-kills 650 >= if 
        6650 ap-send-check "Kills 650!" ap-notify 650 to ap-kills-last 
    then then
    ap-kills-last 700 < if ap-temp-kills 700 >= if 
        6700 ap-send-check "Kills 700!" ap-notify 700 to ap-kills-last 
    then then
    ap-kills-last 750 < if ap-temp-kills 750 >= if 
        6750 ap-send-check "Kills 750!" ap-notify 750 to ap-kills-last 
    then then
    ap-kills-last 800 < if ap-temp-kills 800 >= if 
        6800 ap-send-check "Kills 800!" ap-notify 800 to ap-kills-last 
    then then
    ap-kills-last 850 < if ap-temp-kills 850 >= if 
        6850 ap-send-check "Kills 850!" ap-notify 850 to ap-kills-last 
    then then
    ap-kills-last 900 < if ap-temp-kills 900 >= if 
        6900 ap-send-check "Kills 900!" ap-notify 900 to ap-kills-last 
    then then
    ap-kills-last 950 < if ap-temp-kills 950 >= if 
        6950 ap-send-check "Kills 950!" ap-notify 950 to ap-kills-last 
    then then
    ap-kills-last 1000 < if ap-temp-kills 1000 >= if 
        6999 ap-send-check "Kills 1000!" ap-notify 1000 to ap-kills-last 
    then then
    
    \ === 1100-11000 kills (every 100) ===
    \ ID scheme: 5000 + (kills / 100), so 1100=5011, 2000=5020, 10000=5100
    ap-kills-last 1100 < if ap-temp-kills 1100 >= if 
        5011 ap-send-check "Kills 1100!" ap-notify 1100 to ap-kills-last 
    then then
    ap-kills-last 1200 < if ap-temp-kills 1200 >= if 
        5012 ap-send-check "Kills 1200!" ap-notify 1200 to ap-kills-last 
    then then
    ap-kills-last 1300 < if ap-temp-kills 1300 >= if 
        5013 ap-send-check "Kills 1300!" ap-notify 1300 to ap-kills-last 
    then then
    ap-kills-last 1400 < if ap-temp-kills 1400 >= if 
        5014 ap-send-check "Kills 1400!" ap-notify 1400 to ap-kills-last 
    then then
    ap-kills-last 1500 < if ap-temp-kills 1500 >= if 
        5015 ap-send-check "Kills 1500!" ap-notify 1500 to ap-kills-last 
    then then
    ap-kills-last 1600 < if ap-temp-kills 1600 >= if 

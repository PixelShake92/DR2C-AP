    "AP: Random Armory x5!" ap-notify-item ;
: ap-item-520 3 WEAPON_MOLOTOV trunk.weapon+ "AP: Molotov x3" ap-notify-item ;
: ap-item-521 3 WEAPON_GRENADE trunk.weapon+ "AP: Bombs x3" ap-notify-item ;
: ap-item-522 5 WEAPON_GRENADE trunk.weapon+ "AP: Grenades x5!" ap-notify-item ;
: ap-item-530 ap-random-legendary to ap-rand-weapon 1 ap-rand-weapon trunk.weapon+ "AP: LEGENDARY WEAPON!" ap-notify-item ;

\ === UTILITY (600s) ===
\ Car repair - actually restore engine health (capped at max)
: ap-item-600 
    car-engine 3 + car-max-engine min to car-engine 
    car-update-display
    "AP: Car Parts (+3 Engine)" ap-notify-item 
;
: ap-item-601 
    car-engine 6 + car-max-engine min to car-engine
    car-chassis 2 + car-max-chassis min to car-chassis
    car-update-display
    "AP: Mechanic Kit (+6 Eng, +2 Body)" ap-notify-item 
;
: ap-item-622 ' .fullheal foreach-team-char "AP: Full Heal!" ap-notify-item ;

\ === SPECIAL (700s) ===
: ap-item-700 gstats{ 1 ' zombo-point +! save } "AP: +1 Zombo" ap-notify-item ;
: ap-item-701 gstats{ 2 ' zombo-point +! save } "AP: +2 Zombo" ap-notify-item ;
: ap-item-702 gstats{ 5 ' zombo-point +! save } "AP: +5 Zombo!" ap-notify-item ;

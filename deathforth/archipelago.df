: ap-dispatch
    \ Basic Resources (100s)
    ap-cmd "100" $= if ap-item-100 ' ap-items-received ++ then
    ap-cmd "101" $= if ap-item-101 ' ap-items-received ++ then
    ap-cmd "102" $= if ap-item-102 ' ap-items-received ++ then
    ap-cmd "103" $= if ap-item-103 ' ap-items-received ++ then
    ap-cmd "104" $= if ap-item-104 ' ap-items-received ++ then
    

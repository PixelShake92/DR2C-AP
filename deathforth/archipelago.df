\ Check and send per-mode victory
: ap-check-mode-victory
    \ Victory uses offset 99 within each mode's range
    
    gamedef{ ' defaultmode gamemode? } if
        ap-normal-victory not if
            1 to ap-normal-victory
            99 ap-mode-location ap-send-check
            "[Normal] VICTORY!" ap-notify
        then
    then
    
    gamedef{ ' familiarchars gamemode? } if
        ap-familiar-victory not if
            1 to ap-familiar-victory

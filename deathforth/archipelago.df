\ =============================================================================
\ ARCHIPELAGO - Death Road to Canada Integration
\ Version 3.6 - Fixed kill persistence across runs/deaths
\            - Massively expanded random weapon pools (25+ common melee, 8 common guns,
\              20 uncommon melee, 12 uncommon guns, 18 rare melee, 12 rare guns, 14 legendary)
\ =============================================================================

\ -----------------------------------------------------------------------------
\ STATE VARIABLES - Global (shared across all modes)
\ -----------------------------------------------------------------------------

0 value ap-day-last
0 value ap-day-clear-last
0 value ap-items-received
0 value ap-missions-done
0 value ap-missions-last-sent
0 value ap-kills-last
0 value ap-kills-total       \ Cumulative kills across ALL runs
0 value ap-kills-this-run    \ Track kills at start of this run
0 value ap-kills-accumulated \ Kills from current run already added to ap-kills-total
0 value ap-weapons-total     \ Cumulative weapons picked up across ALL runs
0 value ap-weapons-collected \ Weapons collected THIS RUN (increments on every pickup)
0 value ap-sieges-done
0 value ap-in-siege
0 value ap-siege-last-sent
0 value ap-siege-last-day
0 value ap-temp-id
0 value ap-temp-kills
0 value ap-temp-day
"" value ap-cmd

\ Flag to prevent checks before game actually starts
0 value ap-game-active

\ Toilet tracking
0 value ap-toilets-opened
0 value ap-toilets-last-sent

\ Recruit tracking  
